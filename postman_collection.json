              "raw": "{\n  \"name\": \"Wireless Mechanical Keyboard\",\n  \"sku\": \"KB-W-100\",\n  \"category\": \"Peripherals\",\n  \"unitPrice\": 3500,\n  \"initialStock\": 50,\n  \"minStockAlert\": 10,\n  \"location\": \"Warehouse Rack B-4\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
