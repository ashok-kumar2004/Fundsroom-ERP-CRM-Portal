            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 15,\n  \"movementType\": \"IN\",\n  \"reason\": \"Supplier Restock Shipment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/prod-1/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "prod-1", "stock"]
            }
          }
        },
        {
          "name": "Get Product Stock History",
          "request": {
            "method": "GET",
            "header": [
